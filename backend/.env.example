# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://yourdomain.com

# ─────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────
# Option A — Local MongoDB (same server)
MONGODB_URI=mongodb://localhost:27017/migration-monitor

# Option B — MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/migration-monitor

# ─────────────────────────────────────────────
# Encryption (MUST be exactly 32 characters)
# ─────────────────────────────────────────────
ENCRYPTION_KEY=your-exactly-32-char-key-here!!

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
JWT_SECRET=your-strong-jwt-secret-minimum-32-characters
DEV_JWT_SECRET=your-strong-dev-jwt-secret-min-32-chars

# ─────────────────────────────────────────────
# Dev Login (set to false in production after setup)
# ─────────────────────────────────────────────
SKIP_AUTH=false
ENABLE_DEV_LOGIN=true

# ─────────────────────────────────────────────
# NOTE: All other config (Azure, Metabase, SMTP,
# Projects, Alert Rules) is stored in MongoDB
# via the Admin panel — no .env needed for those.
# ─────────────────────────────────────────────
